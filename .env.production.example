# ==============================================================================
# ROOTS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env)
# Entregable 5: Variables ocultas y CORS en Azure
# ==============================================================================
# En el servidor Azure:
# 1. Copia este archivo como .env: cp .env.production.example .env
# 2. Configura los valores reales
# 3. Protege los permisos: chmod 600 .env (solo legible por tu usuario)
# ==============================================================================

# Entorno
NODE_ENV=production
PORT=4000

# Base de Datos PostgreSQL Aislada en Contenedor (Entregable 4)
POSTGRES_DB=roots_db
POSTGRES_USER=roots_user
POSTGRES_PASSWORD=cambiar_por_contrasena_ultra_segura_2026
DATABASE_URL=postgresql://roots_user:cambiar_por_contrasena_ultra_segura_2026@db:5432/roots_db

# Supabase Cloud (Autenticación OTP y Storage de fotos)
SUPABASE_URL=https://zgjzwnbtfmkixqmnmxkw.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Frontend Next.js Public Envs
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SUPABASE_URL=https://zgjzwnbtfmkixqmnmxkw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_supabase_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# CORS & Red (Entregable 5)
# Coloca la IP pública de tu VM en Azure o tu dominio: ej. http://20.120.45.10
CORS_ORIGIN=*

# Seguridad JWT
JWT_SECRET=super_secreto_para_firmar_tokens_jwt_hackathon_2026
JWT_EXPIRES_IN=7d
