# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stateless_db?retryWrites=true&w=majority
MONGODB_DB_NAME=stateless_db

# PostgreSQL / Direct Database URL (Prisma/PG)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stateless_mobility
