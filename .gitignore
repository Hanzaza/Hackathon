# ==============================================================================
# ROOTS - MASTER .GITIGNORE (Security & Confidentiality)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env*
*.env
*.env.*
!.env.example
!*.env.example
!supabase-env.example

# Private keys, certificates and token files
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.csr
id_rsa*
id_ecdsa*
id_ed25519*

# Cloud & Service credentials
credentials.json
client_secret*.json
serviceAccount*.json
firebase-adminsdk*.json
google-services*.json
GoogleService-Info.plist
*.credentials

# Database backups, exports & dumps
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
*.bak

# ------------------------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. BUILD OUTPUTS & CACHES
# ------------------------------------------------------------------------------
# Next.js
.next/
out/

# TypeScript & Compilation
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel/

# ------------------------------------------------------------------------------
# 4. LOGS & DEBUGGING
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. TESTING & COVERAGE
# ------------------------------------------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM & EDITOR ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 7. AI AGENTS, SCRATCHPADS & TEMPORARY SCRIPTS
# ------------------------------------------------------------------------------
.gemini/
scratch/
.system_generated/
